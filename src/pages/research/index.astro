---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PubItem from "@/components/PubItem.astro";
import TalkEntry from "@/components/TalkEntry.astro";
import LinkList from "@/components/LinkList.astro";
import { comparePapers } from "@/lib/papers";

const papers = (await getCollection("papers", ({ data }) => !data.draft))
  .sort(comparePapers);
const hasCoFirst = papers.some((p) => p.data.authors.some((a) => a.isCoFirst));

const software = (await getCollection("research-code", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const talks = (await getCollection("talks", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sections = [
  { label: "Publications", href: "#publications" },
  { label: "Software", href: "#software" },
  { label: "Talks & posters", href: "#talks" },
];
---
<BaseLayout
  title="Research"
  description="Publications, research software, and conference presentations by Yuanjia (Scott) Yang."
>
  <h1 class="page-title">Research</h1>
  <p class="mt-3 text-muted">Publications, research software, and conference presentations.</p>
  <LinkList links={sections} class="mt-4" />

  <Section id="publications" title="Publications" class="mt-12">
    <ul>
      {papers.map((paper, i) => (
        <PubItem
          paper={paper.data}
          meta={String(paper.data.year)}
          repeatMeta={i > 0 && papers[i - 1].data.year === paper.data.year}
        />
      ))}
    </ul>
    {hasCoFirst && <p class="mt-1 text-xs text-faint">* Equal contribution</p>}
  </Section>

  <Section id="software" title="Software" class="mt-14">
    <ul>
      {software.map((item) => {
        const hasPage = Boolean(item.body?.trim());
        const links = [
          hasPage && { label: "Overview", href: `/research/${item.id}` },
          { label: "GitHub", href: item.data.repo },
          item.data.demo && { label: "Live demo", href: item.data.demo },
          item.data.arxiv && { label: "arXiv", href: item.data.arxiv },
        ].filter((l): l is { label: string; href: string } => Boolean(l));
        return (
          <li class="border-b border-rule py-5 last:border-b-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-medium text-ink">
                {hasPage ? (
                  <a href={`/research/${item.id}`} class="hover:text-accent">{item.data.title}</a>
                ) : (
                  item.data.title
                )}
              </h3>
              <span class="text-sm text-faint">{item.data.org}</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.data.blurb}</p>
            <LinkList links={links} class="mt-2" />
          </li>
        );
      })}
    </ul>
  </Section>

  <Section id="talks" title="Talks & posters" class="mt-14">
    <ul>
      {talks.map((talk) => (
        <TalkEntry
          title={talk.data.title}
          venue={talk.data.venue}
          date={talk.data.date}
          kind={talk.data.kind}
          poster={talk.data.poster}
          slides={talk.data.slides}
        />
      ))}
    </ul>
  </Section>
</BaseLayout>
