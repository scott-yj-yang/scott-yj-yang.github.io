---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Tags from "@/components/Tags.astro";
import LinkList from "@/components/LinkList.astro";
import Figure from "@/components/Figure.astro";

export async function getStaticPaths() {
  const projects = await getCollection("research-code");
  return projects
    .filter((p) => p.body && p.body.trim())
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const links = [
  { label: "GitHub", href: project.data.repo },
  project.data.demo && { label: "Live demo", href: project.data.demo },
  project.data.arxiv && { label: "arXiv", href: project.data.arxiv },
].filter((l): l is { label: string; href: string } => Boolean(l));
---
<BaseLayout title={project.data.title} description={project.data.blurb}>
  <a href="/research#software" class="link text-sm"><span aria-hidden="true">←</span> Research</a>
  <h1 class="page-title mt-6">{project.data.title}</h1>
  {project.data.headline && (
    <p class="mt-2 text-xl font-medium leading-snug tracking-tight text-ink">{project.data.headline}</p>
  )}
  <p class="mt-3 text-muted">{project.data.blurb}</p>
  <Tags tags={[project.data.org, ...project.data.tags]} class="mt-3" />
  <LinkList links={links} class="mt-4" />
  {project.data.cover && (
    <Figure
      src={project.data.cover}
      alt={project.data.coverAlt ?? ""}
      caption={project.data.coverCaption}
      class="mt-8 mb-0"
    />
  )}
  <Prose class="mt-10">
    <Content />
  </Prose>
</BaseLayout>
