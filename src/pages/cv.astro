---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";

const pdf = "/cv/Yuanjia-Scott-Yang-CV.pdf";

const education = [
  {
    degree: "Ph.D. in Neuroscience",
    dates: "Sept 2025 – Present",
    lines: [
      "UC San Diego · Talmo Pereira Lab, Salk Institute for Biological Studies",
      "Focus: Computational Neuroscience, Neuromechanical Modeling, Deep RL",
      "Funding: NIH BRAIN U01 (1U01NS136507)",
    ],
  },
  {
    degree: "M.S. in Computer Science and Engineering — AI",
    dates: "Sept 2023 – Mar 2025",
    lines: [
      "UC San Diego",
      "Thesis: VNL-Ray: Biomechanically Realistic Virtual Rodent Behavior and Task Learning via Deep RL",
    ],
  },
  {
    degree: "B.S. in Data Science & Cognitive Science",
    dates: "Sept 2019 – Mar 2023",
    lines: ["UC San Diego · GPA: 3.94/4 · Magna Cum Laude · Provost's Honor"],
  },
];

const skills = [
  { area: "Programming", items: "Python, JAX, JavaScript, R, MATLAB, Java, SQL, LaTeX" },
  { area: "ML/RL", items: "TensorFlow, PyTorch, Stable-Baselines3, Brax" },
  { area: "Simulation", items: "MuJoCo, MuJoCo-MJX, STAC-MJX" },
  { area: "Infrastructure", items: "Ray, GPU/TPU computing, Docker, Git" },
  { area: "Data", items: "NumPy, SciPy, Pandas, Matplotlib, Scikit-learn" },
];

const teaching = [
  "COGS 188 — Reinforcement Learning (Sp24)",
  "COGS 118B — Unsupervised Machine Learning (Wi23)",
  "COGS 118A — Supervised Machine Learning (Sp23, Wi23, Sp22)",
  "COGS 108 — Data Science in Practice (Fa24, Fa23, Sp23, Wi22)",
  "DSC 30 — Data Structures & Algorithms (Wi22, Fa21, Su21, Sp21)",
  "COGS 18 — Introduction to Python (Wi21)",
  "DSC 10 — Principles of Data Science (Su21)",
];

const honors = [
  { name: "Magna Cum Laude", date: "Mar 2023" },
  { name: "UC Scholars", detail: "Summer Research Scholarship", date: "Summer 2022" },
];
---
<BaseLayout title="CV" description="Curriculum vitae of Yuanjia (Scott) Yang.">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1 class="page-title">Curriculum Vitae</h1>
    <a href={pdf} target="_blank" rel="noopener noreferrer" class="link text-sm">
      Download PDF <span aria-hidden="true">↓</span>
    </a>
  </div>
  <p class="mt-3 text-muted">
    Publications and talks are on the <a href="/research" class="link">Research</a> page.
  </p>

  <Section title="Education" class="mt-12">
    <ul>
      {education.map((item) => (
        <li class="border-b border-rule py-5 last:border-b-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-medium text-ink">{item.degree}</h3>
            <span class="text-sm tabular-nums text-faint">{item.dates}</span>
          </div>
          {item.lines.map((line) => (
            <p class="mt-1 text-sm leading-relaxed text-muted">{line}</p>
          ))}
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Technical skills" class="mt-14">
    <dl class="py-3">
      {skills.map((skill) => (
        <div class="grid gap-x-6 py-2 text-sm sm:grid-cols-[7.5rem_1fr]">
          <dt class="font-medium text-ink">{skill.area}</dt>
          <dd class="text-muted">{skill.items}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section title="Teaching" class="mt-14">
    <p class="pt-5 text-sm text-muted">Teaching Assistant, UC San Diego</p>
    <ul class="mt-3 space-y-1.5 pb-2 text-sm text-ink">
      {teaching.map((course) => <li>{course}</li>)}
    </ul>
  </Section>

  <Section title="Honors & awards" class="mt-14">
    <ul>
      {honors.map((item) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-rule py-4 last:border-b-0">
          <div>
            <h3 class="font-medium text-ink">{item.name}</h3>
            {item.detail && <p class="mt-1 text-sm text-muted">{item.detail}</p>}
          </div>
          <span class="text-sm tabular-nums text-faint">{item.date}</span>
        </li>
      ))}
    </ul>
  </Section>

  <p class="mt-12 text-sm text-faint">
    Full details are in the <a href={pdf} target="_blank" rel="noopener noreferrer" class="link">PDF version</a>.
  </p>
</BaseLayout>
