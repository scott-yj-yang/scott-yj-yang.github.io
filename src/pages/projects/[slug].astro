---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Tags from "@/components/Tags.astro";
import LinkList from "@/components/LinkList.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((p) => p.body && p.body.trim())
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const links = [
  project.data.demo && { label: "Live app", href: project.data.demo },
  project.data.docs && { label: "Docs", href: project.data.docs },
  { label: "GitHub", href: project.data.repo },
].filter((l): l is { label: string; href: string } => Boolean(l));
---
<BaseLayout title={project.data.title} description={project.data.blurb}>
  <a href="/projects" class="link text-sm"><span aria-hidden="true">←</span> Side Projects</a>
  <h1 class="page-title mt-6">{project.data.title}</h1>
  <p class="mt-3 text-muted">{project.data.blurb}</p>
  <Tags tags={project.data.tags} class="mt-3" />
  <LinkList links={links} class="mt-4" />
  <Prose class="mt-10">
    <Content />
  </Prose>
</BaseLayout>
