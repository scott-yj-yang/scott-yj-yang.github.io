---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Tags from "@/components/Tags.astro";

interface Props {
  title: string;
  date: Date;
  tags: string[];
  excerpt?: string;
}

const { title, date, tags, excerpt } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---
<BaseLayout title={title} description={excerpt}>
  <a href="/writing" class="link text-sm"><span aria-hidden="true">←</span> Writing</a>
  <h1 class="page-title mt-6">{title}</h1>
  <p class="mt-3 text-sm text-faint">
    <time datetime={date.toISOString()}>{formatted}</time>
  </p>
  <Tags tags={tags} class="mt-1" />
  <Prose class="mt-10">
    <slot />
  </Prose>
</BaseLayout>
