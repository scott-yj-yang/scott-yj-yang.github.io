---
import { site } from "@/data/site";
---
<footer class="border-t border-rule">
  <div class="mx-auto max-w-3xl px-6 py-8 text-sm text-faint">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        <li>{site.email}</li>
        {site.links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="mt-3 text-xs">{site.funding}</p>
  </div>
</footer>
