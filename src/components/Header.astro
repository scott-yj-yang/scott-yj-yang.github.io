---
import ThemeToggle from "./ThemeToggle.astro";
import { site, demos } from "@/data/site";

const path = Astro.url.pathname;
const under = (href: string) => path === href || path.startsWith(`${href}/`);
// The course demos are listed on Projects, wherever their own address sits.
const onDemo = demos.some((demo) => under(demo.href));
const isCurrent = (href: string) => (onDemo ? href === "/projects" : under(href));
---
<!--
  One row from 640 px: name, menu, theme switch. Below that the menu drops to a
  second row, so every destination stays visible without a hamburger.
-->
<header class="border-b border-rule bg-paper/90 backdrop-blur sm:sticky sm:top-0 sm:z-50">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
    <a href="/" class="text-[0.9375rem] font-semibold tracking-tight text-ink">
      {site.shortName}
    </a>
    <div class="order-2 sm:order-3">
      <ThemeToggle />
    </div>
    <nav aria-label="Main" class="order-3 flex w-full gap-6 sm:order-2 sm:ml-auto sm:w-auto">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "py-1 text-sm",
            isCurrent(item.href) ? "font-medium text-ink" : "text-muted hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
