---
interface Props {
  date: Date;
}

const { date } = Astro.props;
// Date-only values parse as UTC midnight, so format in UTC (see TalkEntry).
const when = date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---
<li class="grid gap-y-1 border-b border-rule py-3 last:border-b-0 sm:grid-cols-[4.5rem_1fr] sm:gap-x-6">
  <div class="text-sm tabular-nums text-faint sm:pt-px">{when}</div>
  <div class="news-body min-w-0 text-[0.9375rem] leading-relaxed text-ink">
    <slot />
  </div>
</li>

<style>
  /* The slot is rendered Markdown, so its links cannot carry utility classes. */
  .news-body :global(a) {
    color: var(--color-accent);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .news-body :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>
