---
/** A row of text links. Links to other sites open in a new tab. */
interface Props {
  links: { label: string; href: string }[];
  class?: string;
}

const { links, class: className } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---
{links.length > 0 && (
  <ul class:list={["flex flex-wrap gap-x-4 gap-y-1 text-sm", className]}>
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="link"
          target={isExternal(link.href) ? "_blank" : undefined}
          rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
)}
